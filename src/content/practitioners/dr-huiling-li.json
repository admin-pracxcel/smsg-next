  "bio": {
    "eyebrow": "About Dr Li",
    "heading_lead": "Meet",
    "heading_warm": "Dr Li.",
    "paragraphs": [
      "Dr Huiling Li is an independent Consultant Specialist GP (ABN: 79 483 658 858) (MED0001198098) consulting at Sans Souci Doctors.",
      "Dr Huiling Li has been practising in local areas for more than a decade and is a Fellow of the Royal Australian College of General Practitioners and a Registered Specialist in General Practice with the Medical Board of Australia.",
      "Dr Li has a particular interest in Women's and Children's health, Infertility, Travel Medicine, Preventative medicine, and Minor Surgical Procedures. Being a dedicated Christian, Dr Li is passionate about making a difference in one's life through her work. In the community, Dr Li is the Chair of the Advisory Council of the Australasian Medical Services Coalition (AMSC) and the inaugural President of the Sun Yet-Sen University of Medical Sciences Sydney Alumni Association. With her strong track record of voluntary work in the community, in 2019, Dr Li was recognized and presented by Mr Mark Coure MP for the St George Community Award in the category of Individual Volunteer Achievement Award. With her exemplary service to the organization, she was also awarded the President Appreciation Award of the Australian Chinese Medical Association in 2019.",
      "Dr Li speaks fluent Cantonese, Mandarin, Hokkienese and English."
    ]
  },
  "fellowships": [
    "Specialist in General Practice, Medical Board of Australia",
    "Accredited Antenatal Shared Care GP (St. George)",
    "MAXHealth Accredited Pre-Employment Medical Assessor"
  ],
  "awards": [
    "SMSG Doctor of the Year Awardee 2020",
    "SMSG Half-Decade Dadication Awardee 2024"
  ],
