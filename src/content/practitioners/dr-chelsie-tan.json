  "bio": {
    "eyebrow": "About Dr Tan",
    "heading_lead": "Meet",
    "heading_warm": "Dr Tan.",
    "paragraphs": [
      "Dr Chelsie (Shiau) Tan is an independent Specialist GP (ABN: 80 622 574 112) (MED0001676905) consulting at the Earlwood centre.",
      "Dr Chelsie Tan completed her medical training at the University of Adelaide. She enjoys looking after patients' general health and disease prevention. She is especially interested in chronic disease management, women's health, and travel medicine. She has also received additional early pregnancy counselling training under the Royal Australian College of General Practitioners. Dr Chelsie was awarded the Fellowship with the Royal Australian College of General Practitioners and registered with the Medical Board of Australia as a Specialist in General Practice.",
      "Dr Chelsie speaks Malay in addition to English."
    ]
  },
  "fellowships": [
    "Consultant Specialist GP",
    "Specialist in General Practice, Medical Board of Australia",
    "RACGP Accredited Supervisor for Registrars in General Practice"
  ],
