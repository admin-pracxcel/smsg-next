  "bio": {
    "eyebrow": "About Dr Yuan",
    "heading_lead": "Meet",
    "heading_warm": "Dr Yuan.",
    "paragraphs": [
      "Dr Grant Yuan is an independent Consultant Specialist GP (ABN: 28 780 713 370) (MED0001867041) consulting at the Earlwood centre.",
      "Dr Grant Yuan completed his medical training at the University of Notre Dame in Sydney. He firmly believes patient-centred care, communication and good record-keeping are the way to look after his patients. He pays particular attention to child and elderly care. With a degree of Master of Surgery and a Certificate in Dermatology, he is strong in surgical and skin procedures. He strives to provide excellent services to his patients and welcomes feedback.",
      "In addition to English, Dr Yuan also speaks fluent Mandarin."
    ]
  },
  "fellowships": [
    "Consultant Specialist GP",
